rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /conversations/{conversationId} {
      allow read, write: if isValidId(conversationId);
    }

    match /messages/{messageId} {
      allow read, write: if isValidId(messageId);
    }

    match /feedback/{feedbackId} {
      allow read, write: if isValidId(feedbackId);
    }

    match /usage/{usageId} {
      allow read, write: if isValidId(usageId);
    }

    match /knowledge_base/{knowledgeId} {
      allow read: if true;
      allow write: if false;
    }

    match /user_kundli_charts/{chartId} {
      allow read, write: if isValidId(chartId);
    }
  }
}
